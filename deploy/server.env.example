# simple-files: candidate for ONE 64-vCPU / 128-GiB app server, NVMe, 25GbE.
# Starting point for measurements, not a measured RPS guarantee.
# The app reads this file via -env. Existing environment values take priority.
# Replace placeholders. Use an existing HTTPS reverse proxy for PUBLIC_URL.
HTTP_ADDR=127.0.0.1:8091
PUBLIC_URL=https://CHANGE_ME_PUBLIC_HOST
ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_RANDOM_PASSWORD
DATA_DIR=/var/lib/gigaquizz/data
MAX_INFLIGHT=65536
MAX_UNIQUE_VOTERS=120000000
MAX_PARTITION_UNIQUE_VOTERS=8000000
FILE_PARTITIONS=32
# Batch and queue limits are per partition; topology is saved per poll.
FILE_BATCH_VOTES=4096
FILE_QUEUE_VOTES=8192
FILE_GROUP_LINGER=2ms
GOMEMLIMIT=96GiB
GOGC=100
# GOMAXPROCS is intentionally unset: use Go's available CPU/cgroup default.
