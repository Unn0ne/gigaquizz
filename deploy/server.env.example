# postgres-kafka: candidate for ONE 64-vCPU / 128-GiB app server, NVMe, 25GbE.
# Starting point for measurements, not a measured RPS guarantee.
# The app reads this file via -env. Existing environment values take priority.
# Replace all service/DB/broker placeholders before configuration validation.
HTTP_ADDR=127.0.0.1:8092
PUBLIC_URL=https://CHANGE_ME_PUBLIC_HOST
ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_RANDOM_PASSWORD
DATABASE_URL=postgres://gigaquizz:CHANGE_ME_DATABASE_PASSWORD@CHANGE_ME_PRIMARY:5432/gigaquizz?sslmode=verify-full
GIGAQUIZZ_SCHEMA=gigaquizz_kafka
KAFKA_BROKERS=CHANGE_ME_BROKER_1:9092,CHANGE_ME_BROKER_2:9092,CHANGE_ME_BROKER_3:9092
KAFKA_ALLOW_REMOTE_BROKERS=true
KAFKA_PARTITIONS=32
KAFKA_BATCH_VOTES=1024
KAFKA_QUEUE_VOTES=8192
KAFKA_LINGER_MS=2
POLL_PREPARATION_SECONDS=60
MAX_INFLIGHT=65536
MAX_UNIQUE_VOTERS=120000000
MAX_PARTITION_UNIQUE_VOTERS=8000000
MAX_STORED_POLLS=10000
GOMEMLIMIT=96GiB
GOGC=100
# GOMAXPROCS is intentionally unset: use Go's available CPU/cgroup default.
# Direct primary/session pooling only: transaction/statement pooling is invalid.
# Explicit single-primary PostgreSQL policy; replication/failover is separate.
DURABILITY_REQUIRED_STANDBYS=0
DURABILITY_STANDBY_NAMES=
# Match the provisioned Kafka listeners. SASL requires verified TLS.
KAFKA_TLS=true
KAFKA_TLS_CA_FILE=
KAFKA_TLS_CERT_FILE=
KAFKA_TLS_KEY_FILE=
KAFKA_TLS_SERVER_NAME=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
