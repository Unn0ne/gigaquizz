# make dev creates .env with a random administrator password.
# External environment values override the file. No database or broker is used.
HTTP_ADDR=127.0.0.1:8091
PUBLIC_URL=http://127.0.0.1:8091
ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_RANDOM_PASSWORD
DATA_DIR=.local/files
MAX_INFLIGHT=4096
MAX_UNIQUE_VOTERS=120000000
FILE_PARTITIONS=1
# Per-partition memory bound defaults to MAX_UNIQUE_VOTERS for legacy journals.
MAX_PARTITION_UNIQUE_VOTERS=120000000
# Queue and batch limits below apply to each partition.
FILE_BATCH_VOTES=4096
FILE_QUEUE_VOTES=65536
FILE_GROUP_LINGER=2ms
