# make dev generates a local .env with a random administrator password.
# This file contains no usable credentials. External values override .env.
HTTP_ADDR=127.0.0.1:8080
PUBLIC_URL=http://127.0.0.1:8080
DATABASE_URL=postgres://gigaquizz:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:55432/gigaquizz?sslmode=disable
ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_RANDOM_PASSWORD
VOTE_DB_CONNECTIONS=64
MAX_INFLIGHT=256
# Explicit physical-replication policy; keep zero/empty for the local single DB.
# Replicated mode requires an exact ANY quorum, named physical slots, and
# monitoring permissions. It does not provide automatic failover.
DURABILITY_REQUIRED_STANDBYS=0
DURABILITY_STANDBY_NAMES=
